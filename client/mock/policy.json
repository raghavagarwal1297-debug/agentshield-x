{
  "roles": {
    "admin": {
      "tools": ["*"],
      "data": { "employees": ["*"], "customers": ["*"] },
      "docs_max_classification": "critical",
      "limits": {}
    },
    "hr": {
      "tools": ["search_records", "read_document", "send_email", "fetch_url"],
      "data": { "employees": ["*"], "customers": ["id", "name", "city"] },
      "docs_max_classification": "critical",
      "limits": { "employee_records_per_session": 10 }
    },
    "intern": {
      "tools": ["search_records", "read_document", "fetch_url", "send_email"],
      "data": { "employees": ["id", "name", "dept"], "customers": ["id", "name", "city"] },
      "docs_max_classification": "internal",
      "email_internal_only": true,
      "limits": { "emails_per_session": 3 }
    }
  },
  "approval_required": [
    { "tool": "issue_refund", "when": "amount > 10000" },
    { "tool": "delete_record" },
    { "tool": "export_data" }
  ],
  "egress": {
    "email_domains_allowed": ["nimbusretail.in"],
    "url_domains_allowed": ["nimbusretail.in", "docs.nimbusretail.in"]
  },
  "redaction": {
    "admin": [],
    "hr": ["secrets"],
    "intern": ["salary", "phone", "pan_like", "secrets"]
  },
  "taint_sources": [
    "employees.salary",
    "secrets",
    "doc:critical"
  ],
  "thresholds": {
    "warn": 30,
    "block": 70,
    "judge_band": [20, 70],
    "judge_timeout_ms": 3000
  },
  "document_classification": {
    "hr_policy.txt": "public",
    "q3_report.txt": "internal",
    "vendor_invoice_oct.txt": "external",
    "partner_email.txt": "external",
    "it_config.txt": "critical"
  }
}
