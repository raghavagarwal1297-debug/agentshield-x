PORT=4000
# groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Model that runs the agent loop (temperature 0).
# H3 check: invoice attack succeeded 10/10 with guard OFF on openai/gpt-oss-120b.
AGENT_MODEL=openai/gpt-oss-120b
# Small fast model for the scanner classifier + incident reports only
JUDGE_MODEL=openai/gpt-oss-20b
# set to "cached" to replay saved LLM responses for the demo scenarios
DEMO_MODE=
