PORT=4000
# groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Model that runs the agent loop (temperature 0).
# H3 check: invoice attack succeeded 10/10 with guard OFF on openai/gpt-oss-120b.
AGENT_MODEL=openai/gpt-oss-120b
# Small fast model for the scanner classifier + incident reports only
JUDGE_MODEL=openai/gpt-oss-20b
# Demo safety net (see llmCache.js):
#   record - call the LLM live and save every response to cache/llm_cache.json
#   cached - replay saved responses (deterministic, works offline); new prompts go live
#   (empty) - live only
DEMO_MODE=
# Per-request LLM timeout and retries on rate limits / network errors
LLM_TIMEOUT_MS=20000
LLM_RATE_RETRIES=3
# Guard mode at startup: off | monitor | enforce
GUARD_MODE=enforce
# Human approval timeout (auto-reject), default 5 minutes
APPROVAL_TIMEOUT_MS=300000
# Set to false to disable PUT /api/policy entirely
ALLOW_POLICY_EDIT=true

# Origins allowed to call the API directly (the Vite dev proxy needs none)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
