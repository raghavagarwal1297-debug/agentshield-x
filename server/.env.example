PORT=4000
# groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Model that runs the agent loop (temperature 0)
AGENT_MODEL=llama-3.3-70b-versatile
# Small fast model for the scanner classifier + incident reports only
JUDGE_MODEL=llama-3.1-8b-instant
# set to "cached" to replay saved LLM responses for the demo scenarios
DEMO_MODE=
